{
  "name": "remount",
  "version": "1.0.0",
  "description": "Mount React components to the DOM using custom elements",
  "keywords": [
    "custom element",
    "mount",
    "onmount",
    "react",
    "web component"
  ],
  "homepage": "https://github.com/rstacruz/remount#readme",
  "bugs": {
    "url": "https://github.com/rstacruz/remount/issues"
  },
  "license": "MIT",
  "author": "Rico Sta. Cruz <rstacruz@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstacruz/remount.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "yarn build"
  },
  "devDependencies": {
    "@types/react": "^18.0.20",
    "@types/react-dom": "^18.0.6",
    "@vitest/browser-playwright": "^5.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">= 18.0.0",
    "react-dom": ">= 18.0.0"
  }
}
